# IQ captures (multi-GB files)
captures/*
!captures/.gitkeep

# Decoder output and raw capture trees. These are regenerated on every
# scan and are the bulk of the clone size; keep a trimmed sample under
# tests/data/ instead.
results/
data/raw/**
!data/raw/**/
!**/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Secrets — never commit credentials or keys
.env
*.key
known_hosts

# SDR artifacts
*.cs8
*.cf32
*.cfile
*.raw
*.iq
*.npy
*.bin
third_party/*/

# ESP-IDF build output
firmware/**/build/
firmware/**/sdkconfig
firmware/**/sdkconfig.old

# ZCode session artifacts
.zcode/
